<div class="container">
    <div class="row">
        {{#each productos}}
            <div class="col">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text">Precio: {{this.precio}} - Stock: {{this.stock}}</p>
                      <a href="/catalogo/{{this._id}}" class="btn btn-primary">Ver</a>
                      <button onclick="agregarProducto('{{this._id}}')" class="btn btn-primary">Agregar</button>
                       <button onclick="eliminarDelCarrito('{{this._id}}')" class="btn btn-danger">Eliminar</button>
                  </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>

<div id="rows" class="row">
  <div class="col" >
    <div id="divrayo1" ></div>
  </div>
  <div id="main" class="col-sm-6">
    <div id="row1" class="row">
      <div class="col-12">
        <h3 class="mt-2 mb-4 a" style="color: white;">¡Encuentra a tus artistas preferidos!</h3>
      </div>
      <div id="sech" class="col-sm-6">
        <div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <div id="item" class="carousel-item active" data-bs-interval="3250">
              <img id="img1" src="./AlbumCover/metallica_livehubbard.jpg"
                class="d-block w-1000" alt="...">
            </div>
            <div class="carousel-item" data-bs-interval="3250">
              <img id="img1"
                src="./AlbumCover/Soda-Stereo-Latin-Grammy.jpg"
                class="d-block w-1000" alt="...">
            </div>
            <div class="carousel-item" data-bs-interval="3250">
              <img id="img1" src="./AlbumCover/radiohead.avif"
                class="d-block w-1000" alt="...">
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleInterval"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleInterval"
            data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    </div>

    <div id="divv">
      <div id="row1" class="row">
        <div class="col-12">
          <h3 class="mt-2 mb-4 a" style="color: white;">Nuestros productos:</h3>
        </div>
        {{#each productos}}
          <div class="col-sm-4">
            <div id="ola1">
                <div class="card card-size" style="width: 18rem;  background-color:  rgb(15, 15, 15);">
                  <div class="image-box">
                    <img id="cards"
                    src="./AlbumCover/AroundTheFur-Deftones.png"
                    class="card-img-top" alt="...">
                  </div>
                  <div class="card-body">
                    <a href="AlbumPages/{{this._id}}">
                    <h5 class="card-title-color">{{this.name}}</h5>
                    </a>
                    <h6 class="card-subtitle card-artist-color mb-2">Deftones</h6>
                    <p class="card-text-color">Precio: {{this.precio}} - Stock: {{this.stock}}</p>
                  </div>
                </div>
            </div>
          </div>  
        {{/each}}  
      </div>
    </div>
  </div>
</div>