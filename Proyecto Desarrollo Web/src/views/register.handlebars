<div id="rows" class="row">
  <div class="col">
    <div id="divrayo1"></div>
  </div>
  <div id="main" class="col-sm-4">
    <!-- Información entre efectos de la pagina -->
    <div class="container">
      <div id="box-login" class="box">

        <form id="form1" action="/register" method="POST">
          <h1>
            <div id="nameForm">
              Tornotes
            </div>
          </h1>

          </h1>
          <div class="mb-3">
            <label for="exampleInputEmail1" class="form-label">Name</label>
            <input type="text" class="form-control" name="username" placeholder="Name">

          </div>
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Email address</label>
            <input type="email" class="form-control" name="email" placeholder="Email address">
          </div>
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Password</label>
            <input type="password" class="form-control" name="password" placeholder="Password">
          </div>
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Confirm Password</label>
            <input type="password" class="form-control" name="confirm_password" placeholder="Confirm password">
          </div>

          <button type="submit" class="btn btn-outline-light">Register</button>
          <a id="yatienescuenta" href="login">Do you already have an account?</a>
        </form>

      </div>
    </div>
    <!-- Fin de los efectos -->
    <div id="divv"></div>
  </div>
  <div class="col">
    <div id="divrayo2"></div>
  </div>
</div>
{{>footer}}