<div id="rows" class="row">
    <div class="col">
        <div id="divrayo1"></div>
    </div>
    <div id="main" class="col-sm-6">
        <div class="container">
            <div class="box">
                <img src={{product.image}} id="imagen-producto" alt="Imagen del producto"
                    class="product-image">
                <div class="product-details">
                    <h1 class="product-title">{{product.productName}}</h1>
                    <h2 class="product-subtitle">{{product.bandName}}</h2>
                    <p class="product-stock">Stock: {{product.stock}}</p>
                    <p class="product-price">Precio: ${{product.price}}</p>                    
                    <p class="product-description">{{product.description}}</p>
                    {{#if user}}
                    <div id="comprar">
                        <form id="form1" action="/albumPages/{{product._id}}" method="POST">
                            <button type="submit" class="btn btn-outline-light">Añadir al carrito</button>
                        </form>
                       
                    </div>
                        <div id="comprar">
                        <form id="form1" action="/delete/{{product._id}}" method="GET">
                            <button type="submit" class="btn btn-outline-danger">Eliminar producto de la base de datos</button>
                        </form>
                       
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
        <div id="divv"></div>
    </div>
    <div class="col">
        <div id="divrayo2"></div>
    </div>
</div>
{{>footer}}