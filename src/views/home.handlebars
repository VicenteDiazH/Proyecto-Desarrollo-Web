<div class="row">
<div id="rows" class="row">
    <div class="col" >
      <div id="divrayo1" ></div>
    </div>
    <div id="main" class="col-sm-6">
      <div id="row1" class="row">
        <div class="col-12">
          <h3 class="mt-2 mb-4 a" style="color: white;">¡Encuentra a tus artistas preferidos!</h3>
        </div>
        <div id="sech" class="col-sm-6">
          <div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
              <div id="item" class="carousel-item active" data-bs-interval="3250">
                <img id="img1" src="/static/AlbumCover/metallica_livehubbard.jpg"
                  class="d-block w-1000" alt="...">
              </div>
              <div class="carousel-item" data-bs-interval="3250">
                <img id="img1"
                  src="/static/AlbumCover/Soda-Stereo-Latin-Grammy.jpg"
                  class="d-block w-1000" alt="...">
              </div>
              <div class="carousel-item" data-bs-interval="3250">
                <img id="img1" src="/static/AlbumCover/radiohead.avif"
                  class="d-block w-1000" alt="...">
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleInterval"
              data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleInterval"
              data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        </div>
      </div>
      <div class="row" id="ola2">
  <div class="col-12">
            <h3 class="mt-2 mb-4 a" style="color: white;">Nuestros productos:</h3>
          </div>
{{#if productos.length}}
{{#each productos}}
   <div class="col-sm-4">
            <div id="ola1">
                <a href="/albumPages/{{_id}}" class="card card-size" style="width: 18rem;  background-color:  rgb(15, 15, 15);">
                  <div class="image-box">
                    <img id="cards"
                    
                    src={{image}}
                    class="card-img-top" alt="...">
                  </div>
                  <div  class="card-body">
                    
                    <h5 id="cards" class="card-title-color">{{productName}}</h5>
                    
                    <h6 class="card-subtitle card-artist-color mb-2">{{bandName}}</h6>
                    <p class="card-text-color">${{price}}</p>
                  </div>
                </a>
            </div>
          </div>
{{/each}}
{{else}}
<div class="col-12">
  <p style="color: #aaa; text-align: center; padding: 30px 0; font-size: 1.1rem;">No hay productos disponibles por el momento.</p>
</div>
{{/if}}
      </div>
     
    
    
    </div>
    <div class="col">
      <div id="divrayo2" >
</div>
    </div>
  </div>


</div>