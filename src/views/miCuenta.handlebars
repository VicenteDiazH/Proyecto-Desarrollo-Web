<div id="rows" class="row">
  <!-- Rayo izquierdo -->
  <div class="col">
    <div id="divrayo1"></div>
  </div>

  <div id="main" class="col-sm-4">      
    <div class="container">
      <div id="box-cuenta" class="box">

        <div class="profile-header">
          <img id="imgProfile" src="{{profilePicture}}" alt="Foto de perfil" class="profile-picture">
          <div class="profile-info">
              <h2>Mi cuenta</h2>
              <p>Nombre: {{username}}</p>
              <p>Correo: {{email}}</p>
          </div>
        </div>

        <form id="logout" method="GET" action="logout">
           <button type="submit" class="btn btn-outline-danger">Logout</button>
        </form>

        <div id="atributosCuenta">
          <!-- Editar perfil -->
          <div class="cuenta-seccion">
            <h3 class="cuenta-titulo">Editar perfil</h3>
            <form action="/updateProfile" method="POST" class="cuenta-form">
              <div class="mb-3">
                <label for="username" class="form-label">Nombre</label>
                <input type="text" class="form-control" name="username" value="{{username}}" placeholder="Nuevo nombre">
              </div>
              <div class="mb-3">
                <label for="profilePicture" class="form-label">URL de foto de perfil</label>
                <input type="text" class="form-control" name="profilePicture" value="{{profilePicture}}" placeholder="URL de imagen">
              </div>
              <button type="submit" class="btn btn-outline-light">Guardar cambios</button>
            </form>
          </div>

          <!-- Wallet -->
          <div class="cuenta-seccion">
            <div class="cuenta-fila">
              <h1 id="walletIcon" class="bi bi-wallet2"></h1>
              <h3>Wallet:</h3>
              <h3 id="dineroWallet">${{wallet}}</h3>
            </div>
            <a href="/wallet">
              <button type="button" class="btn btn-outline-light">Añadir dinero</button>
            </a>
          </div>

          <!-- Recibos -->
          <div class="cuenta-seccion">
            <div class="cuenta-fila">
              <h1 class="bi bi-receipt"></h1>
              <h3>Recibos:</h3>
            </div>
            <a href="/recibos">
              <button type="button" class="btn btn-outline-light">Ver recibos</button>
            </a>
          </div>
        </div>

      </div>
    </div>
    <!-- Fin de los efectos -->
    <div id="divv"></div>
  </div>
  <div class="col">
    <div id="divrayo2"></div>
  </div>
</div>