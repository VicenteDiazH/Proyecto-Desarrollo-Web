<div id="rows" class="row">
    <div class="col">
        <div id="divrayo1"></div>
    </div>
    <div id="main" class="col-sm-4">
        <div class="container">
            <div id="box-cuenta" class="box">
                <h1>
                    <div id="nameForm">
                        Recibos
                    </div>
                </h1>
                <div id="todosRecibos">
                    {{#if receiptToRender.length}}
                    {{#each receiptToRender}}
                    <div id="cadaRecibo" style="border-bottom: 1px solid #333; padding: 15px 0; margin-bottom: 10px;">
                        <h2 id="totalRecibo" style="color: #fff; font-family: 'ola2';">
                            Total: ${{total}}
                        </h2>
                        {{#each products}}
                        <div style="display: flex; align-items: center; gap: 12px; padding: 8px 0;">
                            <img src="{{image}}" alt="{{productName}}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                            <div>
                                <p style="color: #fff; margin: 0; font-weight: bold;">{{productName}}</p>
                                <p style="color: #aaa; margin: 0;">Cantidad: {{quantity}} — ${{price}} c/u</p>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{/each}}
                    {{else}}
                    <div style="text-align: center; padding: 40px 0;">
                        <h1 class="bi bi-receipt" style="font-size: 3rem; color: #555;"></h1>
                        <p style="color: #888; font-size: 1.1rem; margin-top: 10px;">No tienes recibos aún</p>
                        <a href="/" class="btn btn-outline-light" style="margin-top: 10px;">Ir a comprar</a>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
        <div id="divv"></div>
    </div>
    <div class="col">
        <div id="divrayo2"></div>
    </div>
</div>

